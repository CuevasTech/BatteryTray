<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BatteryTray.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Los mismos colores que el icono de batería de Windows 11 (batería baja y cargando). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BatteryLowBrush" Color="#D92C2C" />
                    <SolidColorBrush x:Key="BatteryChargingBrush" Color="#9FD89F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BatteryLowBrush" Color="#C50F1F" />
                    <SolidColorBrush x:Key="BatteryChargingBrush" Color="#107C10" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BatteryLowBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="BatteryChargingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Botón de icono sin fondo, como los de los paneles de Windows 11. -->
            <Style x:Key="FlyoutIconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Título de sección en la ventana de ajustes. -->
            <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="1,24,0,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
