<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BatteryTray.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título propia -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="16" Height="16" VerticalAlignment="Center" Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
            <TextBlock x:Name="TitleBarText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="860" Padding="36,4,36,36" Spacing="4">
                <TextBlock x:Name="PageTitle" Margin="0,0,0,12" Style="{StaticResource TitleTextBlockStyle}" />

                <!-- General -->
                <TextBlock x:Name="GeneralHeader" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsCard x:Name="StartupCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartupToggle" Toggled="StartupToggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="LanguageCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF2B7;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="LanguageCombo" MinWidth="200" SelectionChanged="LanguageCombo_SelectionChanged" />
                </tk:SettingsCard>
                <InfoBar x:Name="RestartBar" IsClosable="True" IsOpen="False" Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Name="RestartButton" HorizontalAlignment="Left" Click="RestartButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Barra de tareas -->
                <TextBlock x:Name="TaskbarHeader" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsCard x:Name="PlacementCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE75B;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="PlacementCombo" MinWidth="200" SelectionChanged="PlacementCombo_SelectionChanged" />
                </tk:SettingsCard>
                <InfoBar x:Name="BarUnavailableBar" IsClosable="False" IsOpen="False" Severity="Warning" />
                <tk:SettingsCard x:Name="TrayModeCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="TrayModeCombo" MinWidth="200" SelectionChanged="TrayModeCombo_SelectionChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="IconStyleCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE83F;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="IconStyleCombo" MinWidth="200" SelectionChanged="IconStyleCombo_SelectionChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="DeviceColorCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="DeviceColorToggle" Toggled="DeviceColorToggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="PinCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE718;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button x:Name="PinButton" Click="PinButton_Click" />
                </tk:SettingsCard>

                <!-- Avisos -->
                <TextBlock x:Name="NotificationsHeader" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsExpander x:Name="LowBatteryExpander" IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEBA0;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="LowBatteryToggle" Toggled="LowBatteryToggle_Toggled" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard x:Name="ThresholdCard">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="ThresholdValue" MinWidth="40" VerticalAlignment="Center" TextAlignment="Right" />
                                <Slider x:Name="ThresholdSlider" Width="200" Maximum="50" Minimum="5" StepFrequency="5"
                                        TickFrequency="5" TickPlacement="Outside" ValueChanged="ThresholdSlider_ValueChanged" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <tk:SettingsCard x:Name="ConnectionCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE702;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ConnectionToggle" Toggled="ConnectionToggle_Toggled" />
                </tk:SettingsCard>

                <!-- Dispositivos -->
                <TextBlock x:Name="DevicesHeader" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock x:Name="DevicesDesc" Margin="1,0,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel x:Name="DevicesPanel" Spacing="4" />

                <!-- Avanzado -->
                <TextBlock x:Name="AdvancedHeader" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsCard x:Name="DemoCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE768;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="DemoToggle" Toggled="DemoToggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="DiagCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEBE8;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button x:Name="DiagButton" Click="DiagButton_Click" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="LogsCard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE838;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button x:Name="LogsButton" Click="LogsButton_Click" />
                </tk:SettingsCard>

                <!-- Acerca de -->
                <TextBlock x:Name="AboutHeader" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsCard x:Name="AboutCard">
                    <tk:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-unplated.png" />
                    </tk:SettingsCard.HeaderIcon>
                    <HyperlinkButton x:Name="SourceLink" />
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
